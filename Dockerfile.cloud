# One container for a permanent public link (Render, Railway, Fly.io…): the built phone app + the API on SQLite.
# For the full production stack (SQL Server, Redis, RQ worker, nginx) use docker-compose.yml instead.
FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ .
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    DATABASE_URL=sqlite:////data/fitvision.db STATIC_DIR=/app/static SEED_DEMO=1 PORT=8000
RUN apt-get update && apt-get install -y --no-install-recommends unixodbc fonts-noto-core fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY server/requirements.txt .
RUN pip install -r requirements.txt && python -m playwright install --with-deps chromium
COPY server/ .
COPY --from=web /web/dist /app/static
RUN mkdir -p /data
EXPOSE 8000
CMD ["sh", "-c", "export DATABASE_URL=${DATABASE_URL:-sqlite:////data/fitvision.db}; python -m app.db_init && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
