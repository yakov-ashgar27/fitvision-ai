ff;strokeColor=#999999;align=right;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>